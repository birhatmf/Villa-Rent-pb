generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Site geneli ayarlar. key: "footer", ileride "header", "seo"…
model Setting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

enum Role {
  GUEST
  HOST
  ADMIN
}

/// Tek tablo + rol: bir üye hem misafir hem ev sahibi olabilir,
/// ikinci bir auth sistemi gerekmez.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  phone          String?
  passwordHash   String
  role           Role      @default(GUEST)
  active         Boolean   @default(true)
  kvkkAcceptedAt DateTime?
  marketingOptIn Boolean   @default(false)
  lastLoginAt    DateTime?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  villas             Villa[]
  favorites          Favorite[]
  bookings           Booking[]               @relation("BookingGuest")
  audits             CalendarAudit[]         @relation("CalendarAuditActor")
  linkedApplications HostApplication[]
  serviceRequests    BookingServiceRequest[] @relation("ServiceRequestRequester")
  reviews            Review[]                @relation("ReviewGuest")
  reviewResponses    ReviewResponse[]        @relation("ReviewResponder")
  moderatedReviews   Review[]                @relation("ReviewModerator")

  @@index([role, active])
  @@index([createdAt])
}

/// Admin panelinden yönetilen sayfalar. Ana sayfa = slug "home".
model Page {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  seoTitle       String?
  seoDescription String?
  sections       Section[]
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
}

/// Sayfayı oluşturan sıralı bloklar. `content` blok tipine göre serbest JSON;
/// dinamik bloklar (featuredVillas, regionGrid) sadece sorgu parametresi tutar,
/// veriyi PagesService hydrate eder.
model Section {
  id      String  @id @default(cuid())
  pageId  String
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type    String
  order   Int
  visible Boolean @default(true)
  content Json    @default("{}")

  @@index([pageId, order])
}

model Region {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  subtitle String?
  image    String
  order    Int     @default(0)
  villas   Villa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Pazarlama/kürasyon koleksiyonları (Balayı, Denize sıfır, Kış konaklaması…).
/// Region'dan farkı: bir villa TEK bölgeye ait ama BİRDEN FAZLA konsepte
/// girebilir (m2m) — "Balayı" + "Denize sıfır" aynı anda olabilir.
model Concept {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  subtitle    String?
  description String?
  image       String
  order       Int     @default(0)
  villas      Villa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VillaStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum BuildingType {
  DETACHED
  SEMI_DETACHED
  SITE
  STONE_HOUSE
  BUNGALOW
}

enum PoolType {
  NONE
  PRIVATE
  SHARED
  INFINITY
}

enum PetPolicy {
  NOT_ALLOWED
  ALLOWED_FREE
  ALLOWED_FEE
}

enum BedType {
  DOUBLE
  TWIN
  SINGLE
  BUNK
  SOFA_BED
}

enum ImageCategory {
  LIVING_KITCHEN
  POOL_GARDEN
  BEDROOM
  EXTERIOR_VIEW
  OTHER
}

enum VillaSalesStatus {
  OPEN
  PAUSED
}

enum VillaBookingMode {
  INSTANT
  REQUEST
}

enum VillaBlockedDateKind {
  MANUAL
  MAINTENANCE
  OWNER_USE
  ICAL
}

enum VillaBlockedDateState {
  ACTIVE
  RELEASED
}

enum BookingStatus {
  REQUESTED
  HOLD
  CONFIRMED
  EXPIRED
  CANCELLED
  DECLINED
  WITHDRAWN
}

enum ServiceRequestType {
  CHANGE
  CANCELLATION
}

enum ServiceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum RefundStatus {
  NONE
  PENDING
  COMPLETED
  REJECTED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum BookingChannel {
  WEBSITE
  ADMIN
}

/// NONE: ödeme beklenmeyen kayıt (admin girişi). PENDING: kapora bekleniyor.
/// DECLARED: misafir havaleyi bildirdi. PAID: admin dekontu doğruladı.
enum BookingPaymentStatus {
  NONE
  PENDING
  DECLARED
  PAID
}

enum IcalSourceStatus {
  PENDING
  ACTIVE
  PAUSED
  ERROR
  REVIEW
}

enum IcalSyncRunStatus {
  RUNNING
  SUCCESS
  NOT_MODIFIED
  FAILED
  REVIEW
}

model Villa {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  summary  String?
  regionId String
  region   Region  @relation(fields: [regionId], references: [id])
  district String?

  status      VillaStatus      @default(DRAFT)
  salesStatus VillaSalesStatus @default(OPEN)
  bookingMode VillaBookingMode @default(INSTANT)
  timezone    String           @default("Europe/Istanbul")
  hostId      String?
  host        User?            @relation(fields: [hostId], references: [id])

  icalExportTokenHash      String?   @unique
  icalExportTokenCreatedAt DateTime? @db.Timestamptz(3)

  buildingType BuildingType
  /// T.C. Kültür ve Turizm Bakanlığı Turizm Amaçlı Konut İzin Belge No —
  /// detay sayfasındaki zorunlu Bakanlık rozetinde gösterilir.
  permitNumber String?
  maxAdults    Int
  maxChildren  Int          @default(0)
  maxInfants   Int          @default(0)
  /// maxAdults+maxChildren'dan servis katmanında otomatik hesaplanır —
  /// mevcut kart bileşenleri ("8 kişi") değişmeden çalışsın diye ayrı tutuluyor.
  capacity     Int
  bedrooms     Int
  bathrooms    Int

  poolType             PoolType @default(NONE)
  poolSecluded         Boolean  @default(false)
  poolHeated           Boolean  @default(false)
  poolHeatingIncluded  Boolean  @default(true)
  poolHeatingFeePerDay Int?
  poolHasChildPool     Boolean  @default(false)
  poolLengthM          Float?
  poolWidthM           Float?
  poolDepthM           Float?

  wifiMbps       Int?
  beachDistanceM Int?
  nearCenter     Boolean  @default(false)
  /// 'sea' | 'nature' — amenities ile aynı serbest tag-bag deseni.
  viewTags       String[]
  amenities      String[]

  pricePerNight              Int
  currency                   String  @default("TRY")
  minNights                  Int     @default(1)
  /// Bu eşiğin ALTINDAKİ konaklamalarda cleaningFee uygulanır, üstünde uygulanmaz.
  cleaningFee                Int     @default(0)
  cleaningFeeThresholdNights Int     @default(7)
  depositAmount              Int     @default(0)
  utilitiesIncluded          Boolean @default(true)
  gasIncluded                Boolean @default(true)
  extraCleaningFee           Int?

  petPolicy             PetPolicy @default(NOT_ALLOWED)
  petNote               String?
  familiesOnly          Boolean   @default(false)
  allowSingleMaleGroups Boolean   @default(true)
  allowYoungGroups      Boolean   @default(true)
  eventsAllowed         Boolean   @default(false)
  smokingAllowed        Boolean   @default(false)
  /// Sabit kurallara ek, host'un serbest metinle eklediği kurallar ("Havuzda cam eşya yasak" vb.).
  customRules           String[]
  checkInTime           String    @default("16:00")
  checkOutTime          String    @default("10:00")
  /// 0=Pazar..6=Cumartesi, null = kısıt yok.
  checkInWeekday        Int?

  videoUrl       String?
  /// Yüzde (örn. 20.0). Kapora oranı — Setting['payments'].depositRate'i bu villada
  /// geçersiz kılar (bkz. bookings/payment.ts prepaymentFor). Kapora platformun tüm
  /// komisyonudur; kalan tutar misafir ile ev sahibi arasında platform dışında kapanır.
  /// Boşsa genel oran kullanılır. Yalnızca admin ayarlar — host-villas.controller.ts
  /// bu alanı DTO'dan düşürür.
  commissionRate Float?
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedBy     String?

  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  featured      Boolean   @default(false)
  featuredOrder Int?
  featuredUntil DateTime?

  rooms          VillaRoom[]
  concepts       Concept[]
  images         VillaImage[]
  favorites      Favorite[]
  priceRules     VillaPriceRule[]
  blockedDates   VillaBlockedDate[]
  bookings       Booking[]
  calendarAudits CalendarAudit[]
  icalSources    IcalSource[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured])
  @@index([hostId])
}

model VillaRoom {
  id      String @id @default(cuid())
  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id], onDelete: Cascade)
  order   Int

  bedType    BedType
  bedCount   Int     @default(1)
  hasEnsuite Boolean @default(false)
  hasJacuzzi Boolean @default(false)
  note       String?

  @@index([villaId, order])
}

/// `url` her zaman kullanılabilir gösterim adresi. `storedName` yalnızca
/// formdan yüklenen dosyalarda dolu — silinirken diskten kaldırmak için.
/// Seed/demo verisi dış URL kullanır (storedName null), gerçek disk dosyası
/// zorlanmaz.
model VillaImage {
  id      String @id @default(cuid())
  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id], onDelete: Cascade)

  category   ImageCategory @default(OTHER)
  url        String
  storedName String?
  fileName   String?
  mimeType   String?
  size       Int?
  width      Int?
  height     Int?
  order      Int
  isCover    Boolean       @default(false)

  createdAt DateTime @default(now())

  @@index([villaId, order])
}

model VillaPriceRule {
  id      String @id @default(cuid())
  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id], onDelete: Cascade)

  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  pricePerNight Int
  minNights     Int?

  createdAt DateTime @default(now())

  @@index([villaId, startDate])
}

model VillaBlockedDate {
  id      String @id @default(cuid())
  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id], onDelete: Cascade)

  startDate  DateTime              @db.Date
  endDate    DateTime              @db.Date
  kind       VillaBlockedDateKind  @default(MANUAL)
  state      VillaBlockedDateState @default(ACTIVE)
  note       String?
  releasedAt DateTime?
  version    Int                   @default(0)

  sourceId            String?
  source              IcalSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  externalUid         String?
  externalRecurrence  String      @default("")
  externalFingerprint String?
  missingCount        Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([villaId, state, startDate])
  @@index([sourceId, state, startDate])
}

model Booking {
  id      String @id @default(cuid())
  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id], onDelete: Restrict)

  guestId String?
  guest   User?   @relation("BookingGuest", fields: [guestId], references: [id], onDelete: SetNull)

  status  BookingStatus
  channel BookingChannel

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  adults   Int
  children Int      @default(0)
  infants  Int      @default(0)

  customerName  String?
  customerEmail String?
  customerPhone String?

  currency            String
  accommodationAmount Int
  cleaningFeeAmount   Int
  depositAmount       Int
  totalAmount         Int
  priceSnapshot       Json

  paymentStatus     BookingPaymentStatus @default(NONE)
  prepaymentAmount  Int                  @default(0)
  paymentDeclaredAt DateTime?            @db.Timestamptz(3)

  holdExpiresAt    DateTime? @db.Timestamptz(3)
  confirmedAt      DateTime? @db.Timestamptz(3)
  cancelledAt      DateTime? @db.Timestamptz(3)
  cancellationNote String?

  idempotencyOwner String
  idempotencyKey   String
  requestHash      String
  version          Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  serviceRequests BookingServiceRequest[]
  review          Review?

  @@unique([idempotencyOwner, idempotencyKey])
  @@index([villaId, status, checkIn, checkOut])
  @@index([guestId, createdAt])
  @@index([paymentStatus, createdAt])
}

/// Onaylı bir rezervasyonda misafirin (değişiklik/iptal) veya ev sahibinin
/// (yalnızca iptal) doğrudan yapamadığı, admin/host onayı gereken işlemler.
/// Aynı rezervasyon+tür için tek aktif PENDING kaydı DB kısıtıyla korunur
/// (bkz. 20260908_service_requests.sql — Prisma şeması kısmi unique index'i
/// ifade edemez). Kaporanın iadesi POS olmadığı için otomatik değildir; admin
/// CANCELLATION talebini onaylarken banka üzerinden yapılan iadeyi ayrıca not eder.
model BookingServiceRequest {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  requestedBy String
  requester   User   @relation("ServiceRequestRequester", fields: [requestedBy], references: [id], onDelete: Cascade)

  type   ServiceRequestType
  status ServiceRequestStatus @default(PENDING)

  /// CHANGE için istenen yeni tarih/misafir sayısı: { from, to, adults, children, infants }.
  payload Json?

  customerNote    String?
  resolutionNote  String?
  refundStatus    RefundStatus @default(NONE)
  refundAmount    Int          @default(0)
  refundNote      String?
  refundUpdatedAt DateTime?    @db.Timestamptz(3)

  version    Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  resolvedBy String?

  @@index([bookingId, type, status])
  @@index([status, createdAt])
}

/// Yalnızca tamamlanmış ve kullanıcıya bağlı onaylı konaklamadan üretilebilir.
/// bookingId unique kısıtı eşzamanlı çift gönderimi veritabanında da engeller.
model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id], onDelete: Restrict)
  guestId String
  guest   User   @relation("ReviewGuest", fields: [guestId], references: [id], onDelete: Restrict)

  rating Int
  body   String
  status ReviewStatus @default(PUBLISHED)

  moderationReason String?
  moderatedAt      DateTime? @db.Timestamptz(3)
  moderatedBy      String?
  moderator        User?     @relation("ReviewModerator", fields: [moderatedBy], references: [id], onDelete: SetNull)

  response  ReviewResponse?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  @@index([villaId, status, createdAt])
  @@index([guestId, createdAt])
}

/// Yayındaki yoruma ev sahibinin tek yanıtı. Customer yanıt zinciri açılmaz.
model ReviewResponse {
  id       String @id @default(cuid())
  reviewId String @unique
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  responderId String?
  responder   User?    @relation("ReviewResponder", fields: [responderId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model IcalSource {
  id      String @id @default(cuid())
  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id], onDelete: Restrict)

  label         String
  urlCiphertext String
  urlHash       String           @unique
  required      Boolean          @default(true)
  status        IcalSourceStatus @default(PENDING)

  lastAttemptAt       DateTime? @db.Timestamptz(3)
  lastSuccessAt       DateTime? @db.Timestamptz(3)
  coverageStart       DateTime? @db.Date
  coverageEnd         DateTime? @db.Date
  etag                String?
  lastModified        String?
  nextSyncAt          DateTime  @default(now()) @db.Timestamptz(3)
  consecutiveFailures Int       @default(0)
  lastErrorCode       String?

  leaseToken     String?   @unique
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  version        Int       @default(0)
  deletedAt      DateTime? @db.Timestamptz(3)

  blocks VillaBlockedDate[]
  runs   IcalSyncRun[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, nextSyncAt])
  @@index([villaId, deletedAt])
}

model IcalSyncRun {
  id       String     @id @default(cuid())
  sourceId String
  source   IcalSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  status        IcalSyncRunStatus @default(RUNNING)
  addedCount    Int               @default(0)
  updatedCount  Int               @default(0)
  releasedCount Int               @default(0)
  conflictCount Int               @default(0)
  httpStatus    Int?
  errorCode     String?

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)

  @@index([sourceId, startedAt])
}

model CalendarAudit {
  id      String  @id @default(cuid())
  villaId String
  villa   Villa   @relation(fields: [villaId], references: [id], onDelete: Restrict)
  actorId String?
  actor   User?   @relation("CalendarAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String
  action     String
  reason     String?
  before     Json?
  after      Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([villaId, createdAt])
  @@index([entityType, entityId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OwnershipType {
  SOLE
  SHARED
  SITE
}

enum DocumentType {
  PERMIT_CERTIFICATE
  PLAQUE_PHOTO
  TITLE_DEED
  ID_DOCUMENT
  FIRE_SAFETY_DECLARATION
  POWER_OF_ATTORNEY
  CONSENT_LETTER
  MANAGEMENT_DECISION
  OTHER
}

/// "Villa Kayıt ve Ön Başvuru Formu" — 7464 sayılı Kanun kapsamındaki resmi
/// alanları birebir taşır. Başvuru sahibi kayıtlı kullanıcı olmak zorunda değil;
/// onay sonrası ev sahibi hesabına bağlama ayrı bir modülde (Ev sahipleri) yapılacak.
model HostApplication {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(PENDING)

  // 1. Villa Sahibi / Yetkili Bilgileri
  ownerName     String
  ownerIdNumber String
  phone         String
  email         String
  uetsAddress   String?
  iban          String

  // 2. Mülk ve İzin Bilgileri
  address       String
  parcelNo      String?
  permitNumber  String?
  maxCapacity   Int?
  kbsCode       String?
  ownershipType OwnershipType

  // 4. Taahhüt ve onay
  termsAcceptedAt DateTime
  signatureName   String

  // İnceleme
  adminNote  String?
  reviewedAt DateTime?
  reviewedBy String?

  // Onboarding bağlama: onaylı başvuru gerçek bir HOST hesabına bağlanır.
  // Başvuru kalıcı kaynak kayıt olarak kalır — alanları başka yere kopyalanmaz.
  linkedHostId String?
  linkedHost   User?   @relation(fields: [linkedHostId], references: [id], onDelete: SetNull)

  documents HostApplicationDocument[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([linkedHostId])
}

/// Diskteki gerçek dosya adı (storedName) rastgele üretilir; orijinal ad
/// yalnızca görüntüleme için saklanır — yol/isim çakışması ve path traversal riski olmasın.
model HostApplicationDocument {
  id            String          @id @default(cuid())
  applicationId String
  application   HostApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          DocumentType
  fileName      String
  storedName    String
  mimeType      String
  size          Int
  uploadedAt    DateTime        @default(now())

  @@index([applicationId])
}

model Favorite {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  villaId String
  villa   Villa  @relation(fields: [villaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, villaId])
  @@index([villaId])
}
