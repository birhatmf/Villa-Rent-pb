    "test:payment": "ts-node test/payment-unit.ts",
    "test:booking-concurrency": "ts-node test/booking-concurrency.ts",
    "test:customer-access": "ts-node test/customer-access.ts",
    "test:reviews": "ts-node test/reviews-unit.ts",
    "test:ical-parser": "ts-node test/ical-parser.ts",
    "test:ical-security": "ts-node test/ical-security.ts",
    "test:ical-sync": "ts-node test/ical-sync.ts",
    "db:push": "prisma db push",
    "db:create-admin": "node --env-file=.env -r ts-node/register prisma/create-admin.ts",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.1",
